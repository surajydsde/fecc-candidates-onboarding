# GEMINI_API_KEY: Required for the AI chat. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# OWNER_PASSCODE: Unlocks owner mode (upload, download and delete Excel sheets).
# Checked on the server only; never ships to the browser. Use a long, unique value.
OWNER_PASSCODE="choose-a-long-unique-passcode"

# BLOB_READ_WRITE_TOKEN: Added automatically when you connect a Vercel Blob store
# to the project (Storage tab). Stores uploaded sheets and the upload history.
# Without it, uploads are kept in memory locally, and uploading is disabled on Vercel.
# BLOB_READ_WRITE_TOKEN=""
